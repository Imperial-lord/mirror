// Copy to Local.xcconfig; this file is ignored by Git.
// Must match the bundle ID registered with your Firebase iOS app.
PRODUCT_BUNDLE_IDENTIFIER = com.example.mirror
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// xcconfig treats // as a comment, so use /$()/ for URL separators.
PLAYBACK_SERVICE_URL = http:/$()/127.0.0.1:8787
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID
